<qnx xmlns="http://www.qnx.com/schemas/application/1.0">

<!-- BlackBerry 10 application descriptor file.

    Specifies parameters for identifying, installing, and launching native applications on BlackBerry 10.

-->

    <!-- A universally unique application identifier. Must be unique across all BlackBerry 10 applications.
         Using a reverse DNS-style name as the id is recommended. (Eg. com.example.ExampleApplication.) Required. -->
    <id>ch.michioxd.bbcord</id>
    <configuration name="Device-Debug">
       <platformArchitecture>armle-v7</platformArchitecture>
       <asset path="arm/o.le-v7-g/BBCord" entry="true" type="Qnx/Elf">BBCord</asset>
    </configuration>
    <configuration name="Device-Release">
       <entryPointType>Qnx/Cascades</entryPointType>
       <platformArchitecture>armle-v7</platformArchitecture>
       <asset path="arm/o.le-v7/BBCord.so" entry="true" type="Qnx/Elf">BBCord.so</asset>
    </configuration>
    <configuration name="Device-Profile">
       <platformArchitecture>armle-v7</platformArchitecture>
       <asset path="arm-p/o.le-v7-g/BBCord" entry="true" type="Qnx/Elf">BBCord</asset>
    </configuration>
    <configuration name="Simulator-Debug">
       <platformArchitecture>x86</platformArchitecture>
       <asset path="x86/o-g/BBCord" entry="true" type="Qnx/Elf">BBCord</asset>
    </configuration>

    <!-- The name that is displayed in the BlackBerry 10 application installer.
         May have multiple values for each language. See samples or xsd schema file. Optional. -->
    <name>BBCord</name>

    <!-- A string value of the format <0-999>.<0-999>.<0-999> that represents application version which can be used to check for application upgrade.
         Values can also be 1-part or 2-part. It is not necessary to have a 3-part value.
         An updated version of application must have a versionNumber value higher than the previous version. Required. -->
    <versionNumber>1.0.1</versionNumber>

    <!-- Fourth digit segment of the package version. First three segments are taken from the
         <versionNumber> element.  Must be an integer from 0 to 2^16-1 -->
    <buildId>0</buildId>

    <!-- A string value (such as "v1", "2.5", or "Alpha 1") that represents the version of the application, as it should be shown to users. Optional. -->
    <!-- <versionLabel></versionLabel> -->

    <!-- Description, displayed in the BlackBerry 10 application installer.
         May have multiple values for each language. See samples or xsd schema file. Optional. -->
    <description>Cascades Discord client for BlackBerry 10</description>

    <!-- Copyright information. Optional. -->
    <!-- <copyright></copyright> -->

    <!--  Name of author which is used for signing. Must match the developer name of your development certificate. -->
    <icon>
       <image>icon.png</image>
       <image>icon110.png</image>
       <image>icon86.png</image>
       <image>icon90.png</image>
       <image>icon96.png</image>
    </icon>
    <splashScreens>
       <image>splash.png</image>
       <image>splash1280x720.png</image>
       <image>splash1280x768.png</image>
       <image>splash720.png</image>
       <image>splash720x1280.png</image>
       <image>splash768x1280.png</image>
    </splashScreens>
    <author>michioxd</author>

    <!--  Unique author ID assigned by signing authority. Required if using debug tokens. -->
    <!-- <authorId>ABC1234YjsnUk235h</authorId> -->

    <initialWindow>
        <autoOrients>true</autoOrients>
        <systemChrome>none</systemChrome>
    </initialWindow>

    <!--  The icon for the application, which should be 114x114. -->

    <asset path="assets">assets</asset>

    <!-- Public asset folder for BlackBerry Hub (UDS) integration. Must be
         a SEPARATE top-level folder from "assets" above (not nested inside
         it) and declared public="true", or the Hub process cannot read the
         icon files at runtime (see HubIntegration.cpp for the underlying
         UDS calls). Folder name must not start with the string "assets" -
         Momentics (NDK 10.3.1) appears to reject public asset folder names
         that share that prefix with the already-declared "assets" rule. -->
    <asset path="hub-icons" public="true">hub-icons</asset>

    <!-- Invoke target cho BlackBerry Hub "Open in BBCord" (long-press item
         action đăng ký bằng uds_register_item_context_action trong
         HubIntegration.cpp, target="ch.michioxd.bbcord.invoke",
         type="service"). 4 filter action/mime-type kết hợp — kế thừa
         nguyên bộ filter đã dùng bên Zalo10's HubIntegration (cùng tác
         giả, cùng kiến trúc UDS) vì action Hub thực tế gửi khi tap/
         long-press 1 item chưa được xác nhận chắc chắn là OPEN hay VIEW,
         và mime type item vs mime type action-registration cũng khác
         nhau (plain/message cho item, text/plain cho action) — giữ cả 4
         tổ hợp để không bỏ sót trường hợp nào. -->
    <invoke-target id="ch.michioxd.bbcord.invoke">
        <invoke-target-type>application</invoke-target-type>
        <filter>
            <action>bb.action.OPEN</action>
            <mime-type>text/plain</mime-type>
        </filter>
        <filter>
            <action>bb.action.VIEW</action>
            <mime-type>text/plain</mime-type>
        </filter>
        <filter>
            <action>bb.action.OPEN</action>
            <mime-type>plain/message</mime-type>
        </filter>
        <filter>
            <action>bb.action.VIEW</action>
            <mime-type>plain/message</mime-type>
        </filter>
    </invoke-target>

    <!-- Locale support -->
    <asset path="translations" dest="qm">
        <include name="*.qm"/>
    </asset>
    <asset path="icon.png">icon.png</asset>
    <asset path="icon110.png">icon110.png</asset>
    <asset path="icon86.png">icon86.png</asset>
    <asset path="icon90.png">icon90.png</asset>
    <asset path="icon96.png">icon96.png</asset>
    <asset path="splash.png">splash.png</asset>
    <asset path="splash1280x720.png">splash1280x720.png</asset>
    <asset path="splash1280x768.png">splash1280x768.png</asset>
    <asset path="splash720.png">splash720.png</asset>
    <asset path="splash720x1280.png">splash720x1280.png</asset>
    <asset path="splash768x1280.png">splash768x1280.png</asset>

    <!-- Request permission to execute native code.  Required for native applications. -->
    <permission system="true">run_native</permission>
    <permission>access_internet</permission>
    <permission system="true">_sys_run_headless</permission>
    <permission>access_shared</permission>
    <permission>use_camera</permission>
    <permission>post_notification</permission>
    <permission>run_when_backgrounded</permission>
    <permission>access_notify_settings_control</permission>
    <permission>record_audio</permission>
    <permission>read_device_identifying_information</permission>
    <permission>access_wifi_public</permission>
    <!-- Required for HubIntegration.cpp (bb::pim::unified / UDS API) to
         connect to the BlackBerry Hub - the Hub is part of the PIM domain
         on BB10, and uds_init() fails with UDS_ERROR_FAILED (501) without
         this permission. Confirmed against Zalo10's bar-descriptor.xml,
         which declares this same permission for its own working Hub
         integration (see HubIntegration.cpp there). -->
    <!-- Bắt buộc cho UDS (Unified Data Source / Hub integration, xem
         src/core/HubIntegration.cpp): PPS object "/pps/services/pim/unified"
         mà uds_init()/uds_register_client() nói chuyện tới được BlackBerry
         bảo vệ bởi quyền hệ thống này. Đây là quyền hạn chế ("_sys_"
         prefix) — thiếu dòng này khiến uds_init() fail ngay từ bước đầu
         tiên với mã lỗi generic UDS_ERROR_FAILED (501), như đã xác nhận
         qua log thực tế trên thiết bị. Theo tài liệu BlackBerry, quyền
         restricted này có thể cần được BlackBerry cấp riêng để chạy chặt
         trên production/BlackBerry World, nhưng vẫn phải khai báo ở đây dù
         build bằng self-signed/debug token. -->
    <permission system="true">_sys_access_pim_unified</permission>
    <permission>access_pimdomain_messages</permission>
    <env var="LD_LIBRARY_PATH" value="app/native/lib:/usr/lib/qt4/lib"/>
    <env var="CASCADES_THEME" value="dark?primaryColor=0x7289DA&amp;primaryBase=0x7289DA"/>
</qnx>
